# Copiar y editar (NO subir redeploy.env a Git):
#   cp redeploy.env.example redeploy.env
#
# Redeploy del catálogo hardware: seed SQL, rollout backend/frontend, smoke tests.
# Pensado para cluster con Semana 4 (Tekton build + ArgoCD sync desde Git).

# --- Rutas (opcional; el script las infiere desde ansible-k8s/) ---
# REPO_ROOT=~/JeanOS
# REDEPLOY_ENV=~/JeanOS/ansible-k8s/redeploy.env
# SEED_SQL=~/JeanOS/ansible-k8s/seed-productos.sql

# --- Kubernetes ---
K8S_NAMESPACE=jeanos-shop
POSTGRES_POD=postgres-0
POSTGRES_USER=jeanosadmin
POSTGRES_DB=jeanosdb
# POSTGRES_READY_TIMEOUT=120
# KUBECONFIG=~/.kube/config

# --- Imágenes (deben coincidir con Deployments y Tekton lab.env) ---
# Obligatorio solo si BUILD_IMAGES=true
REGISTRY=docker.io/TU_USUARIO_DOCKERHUB
IMAGE_TAG=v1
DOCKER_BACKEND_IMAGE=jeanos-backend
DOCKER_FRONTEND_IMAGE=jeanos-frontend
# BUILD_PLATFORM=linux/amd64
# BUILD_SCRIPT=~/JeanOS/scripts/build-push-x86-aliothosa.sh

# --- Pasos del redeploy (true/false) ---
#
# Opción A — GitOps (recomendado con Semana 4):
#   Tekton hace build/push tras git push; ArgoCD aplica manifests.
BUILD_IMAGES=false
PUSH_IMAGES=false
RUN_SEED=true
APPLY_MANIFESTS=false
RESTART_DEPLOYMENTS=true
#
# Lab local sin Tekton (build en esta máquina):
# BUILD_IMAGES=true
# PUSH_IMAGES=true
# APPLY_MANIFESTS=true

WAIT_ROLLOUT=true
RUN_SMOKE_TESTS=true
SHOW_INIT_LOGS=true

# --- Semana 4 / GitOps ---
# Si aplicas manifests a mano con ArgoCD auto-sync activo, el cluster volverá al estado del repo.
PAUSE_ARGOCD_SYNC=false
ARGOCD_APP_NAME=jeanos-shop-gitops
ARGOCD_NAMESPACE=argocd

# --- Pruebas smoke (compare usa 3 IDs de GPU del seed) ---
COMPARE_ID_1=1
COMPARE_ID_2=2
COMPARE_ID_3=3
PRODUCTS_CLASS_FILTER=gpu
FRONTEND_NODE_PORT=30080
# NODE_IP=192.168.1.10
